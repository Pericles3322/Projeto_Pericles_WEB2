{
  "name": "pc-stock",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "api": "json-server --watch db.json --port 3000",
    "json:server:routes": "json-server --watch db.json --routes routes.json --port 3000",
    "sass": "sass --watch --load-path=node_modules assets/scss/bootstrap.scss:assets/styles/bootstrap.css assets/scss/main.scss:assets/styles/style.css --style=expanded --no-source-map --quiet-deps",
    "build:css": "sass --load-path=node_modules assets/scss/bootstrap.scss assets/styles/bootstrap.css --style=expanded --no-source-map --quiet-deps && sass assets/scss/main.scss assets/styles/style.css --style=expanded --no-source-map",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "json-server": "^0.17.4",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "vite": "^8.0.7"
  }
}
